{
  "name": "@bloxifi/web",
  "version": "1.0.16",
  "private": false,
  "description": "BloxiFI web application",
  "author": "Aleksa Toljic <aleksa.toljic@bloxico.com>",
  "license": "ISC",
  "main": "src/main.tsx",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "preserve": "yarn prebuild",
    "serve": "cross-env NODE_ENV=development webpack serve --config config/webpack.dev.js",
    "prebuild": "yarn generate:routes",
    "generate:routes": "node scripts/routes.js",
    "build": "webpack --config ./config/webpack.prod.js"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "devDependencies": {
    "@babel/runtime": "^7.18.6",
    "@types/react-router-dom": "^5.3.3",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.9.3"
  },
  "dependencies": {
    "@bloxifi/build": "^1.0.0",
    "@bloxifi/core": "^1.0.0",
    "@bloxifi/ui": "^1.0.0",
    "@metamask/detect-provider": "^1.2.0",
    "@web3-react/injected-connector": "^6.0.7",
    "formik": "^2.2.9",
    "normalize.css": "^8.0.1",
    "react-router-dom": "^6.3.0",
    "unstated-next": "^1.1.0",
    "yup": "^1.0.2"
  }
}
