  "license": "MIT",
  "scripts": {
    "test": "CYPRESS_REMOTE_DEBUGGING_PORT=9222 node -r dotenv/config node_modules/.bin/cypress open",
    "start": "http-server apps/web/dist -P http://localhost:3000? -g -s -p 3000",
    "test:e2e": "CYPRESS_REMOTE_DEBUGGING_PORT=9222 node -r dotenv/config node_modules/.bin/cypress run --browser chrome --headed",
    "ci:e2e": "start-server-and-test start http://localhost:3000 test:e2e"
  },
  "devDependencies": {
    "start-server-and-test": "^1.14.0",
    "http-server": "^14.1.1",
    "etherscan-api": "^10.2.0",
    "cypress": "^9.7.0",
    "@testing-library/cypress": "^8.0.3",
    "bytes32": "^0.0.3",
    "cross-zip": "^4.0.0",
    "node-fetch": "^3.3.0",
    "puppeteer-core": "^19.2.2",
    "cypress-wait-until": "^1.7.2",
    "eslint-plugin-cypress": "^2.12.1",
    "eslint-plugin-chai-friendly": "^1.1.1",
    "eslint-plugin-ui-testing": "^2.0.1",
    "eslint-plugin-testing-library": "^5.9.1"
  }
}
